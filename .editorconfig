# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{ts,tsx,js,jsx,mjs,cjs}]
quote_type = single
ij_typescript_use_double_quotes = false

[*.{json,jsonc}]
indent_size = 2

[*.html]
indent_size = 2
quote_type = single

[*.{css,scss,less}]
indent_size = 2

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4
